# One line ending everywhere, so a checkout on another platform does not churn.
* text=auto eol=lf

# Recorded screens. Byte-exact by definition — never touched by a filter.
tests/snapshots/*.txt text eol=lf
tests/fixtures/* text eol=lf

# cairn's conformance corpus, vendored unmodified. Byte-exact for a stronger
# reason than the snapshots: one of its cases is a file written with CRLF
# endings, so a filter that normalised line endings here would not alter the
# test, it would delete it.
tests/fixtures/conformance/** -text

# cairn item files, which are also the project's roadmap.
cairn/items/*.md text eol=lf

# Not written by hand, and not worth reviewing line by line.
Cargo.lock linguist-generated=true
ROADMAP.md linguist-generated=true

# ROADMAP.md is generated from the items. On a merge, re-derive it rather than
# trying to reconcile two renderings of different inputs.
ROADMAP.md merge=cairn

# An item is the source rather than a rendering, so it cannot be re-derived.
# The driver unions its sequence fields, where two branches both meant what
# they added, and leaves everything else to a person.
cairn/items/*.md merge=cairn
